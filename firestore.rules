rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Fetches the user data from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check roles
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role == 'admin';
    }

    function isCurator() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (getUserData().role == 'curator' || getUserData().role == 'admin');
    }

    // 1. Users collection rules
    match /users/{uid} {
      allow read: if isOwner(uid) || isCurator();
      allow create: if isAuthenticated() && request.auth.uid == uid;
      // Normal user cannot escalate their role to admin/curator; only admins can change roles.
      allow update: if isOwner(uid) && 
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Products collection rules
    match /products/{productId} {
      allow read: if true; // Public catalog access
      allow write: if isCurator(); // Add/Edit/Delete restricted to Curators/Admins
      
      // Nested Reviews rules
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
        allow delete: if isCurator() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      }
    }

    // 3. Collection Group matching for reviews moderation (requires indexing)
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
      allow write: if isCurator() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // 4. Cart collection rules
    match /cart/{uid}/items/{productId} {
      allow read, write: if isOwner(uid) || isCurator();
    }

    // 5. Favorites/Wishlist collection rules
    match /favorites/{uid}/items/{productId} {
      allow read, write: if isOwner(uid);
    }

    // 6. Orders collection rules
    match /orders/{orderId} {
      // User can read their own orders; Curators/Admins can read all
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isCurator();
      // User can place order if verified owner
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Only Curators/Admins can update orders (e.g. status transition)
      allow update: if isCurator();
      allow delete: if isAdmin();
    }

    // 7. Categories collection rules
    match /categories/{categoryId} {
      allow read: if true; // Public access
      allow write: if isCurator(); // Curators/Admins only
    }
  }
}
